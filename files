#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

const int TAM_MAX = 50; // tamaño máximo permitido para los arreglos
const float NOTA_MINIMA_APROBAR = 70.0; // umbral de aprobación

/*
 * Llena los arreglos paralelos "nombres" y "notas" pidiendo los datos
 * por teclado. Usa la MISMA posición de índice para relacionar el
 * nombre de un estudiante con su calificación (arreglos paralelos).
 * Valida que la nota esté en el rango 0-100.
 */
void llenarDatos(string nombres[], float notas[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "\n--- Estudiante " << (i + 1) << " ---" << endl;

        cout << "Nombre: ";
        cin.ignore();
        getline(cin, nombres[i]);

        float nota;
        bool valida = false;

        // Ciclo de validacion: repite hasta que la nota este en rango 0-100
        while (!valida) {
            cout << "Calificacion (0-100): ";
            cin >> nota;

            if (nota < 0 || nota > 100) {
                cout << "Error: la nota debe estar entre 0 y 100. Intente de nuevo." << endl;
            }
            else {
                valida = true;
            }
        }

        notas[i] = nota;
    }
}

/*
 * Recorre ambos arreglos e imprime una tabla ordenada con
 * el nombre y la calificacion de cada estudiante.
 */
void mostrarDatos(string nombres[], float notas[], int n) {
    cout << "\n===================================" << endl;
    cout << "      LISTADO DE CALIFICACIONES" << endl;
    cout << "===================================" << endl;
    cout << left << setw(20) << "Nombre" << "Calificacion" << endl;
    cout << "-----------------------------------" << endl;

    for (int i = 0; i < n; i++) {
        cout << left << setw(20) << nombres[i] << fixed << setprecision(2) << notas[i] << endl;
    }
}

/*
 * Calcula el promedio general sumando todas las notas
 * y dividiendo entre la cantidad de estudiantes.
 */
float calcularPromedio(float notas[], int n) {
    float suma = 0;
    for (int i = 0; i < n; i++) {
        suma += notas[i];
    }
    return suma / n;
}

/*
 * Recorre el arreglo de notas comparando con if/else para
 * encontrar la calificacion mas alta y el indice donde ocurre.
 * Se asume que el primer estudiante tiene la nota maxima y se
 * va comparando contra el resto.
 */
int buscarMaximo(float notas[], int n) {
    int indiceMax = 0;
    for (int i = 1; i < n; i++) {
        if (notas[i] > notas[indiceMax]) {
            indiceMax = i;
        }
    }
    return indiceMax;
}

/*
 * Misma logica que buscarMaximo, pero para encontrar
 * la calificacion mas baja.
 */
int buscarMinimo(float notas[], int n) {
    int indiceMin = 0;
    for (int i = 1; i < n; i++) {
        if (notas[i] < notas[indiceMin]) {
            indiceMin = i;
        }
    }
    return indiceMin;
}

/*
 * Recorre el arreglo de notas y cuenta cuantos estudiantes
 * aprobaron (nota >= NOTA_MINIMA_APROBAR) y cuantos reprobaron.
 * Los resultados se devuelven mediante parametros por referencia.
 */
void contarAprobadosReprobados(float notas[], int n, int& aprobados, int& reprobados) {
    aprobados = 0;
    reprobados = 0;

    for (int i = 0; i < n; i++) {
        if (notas[i] >= NOTA_MINIMA_APROBAR) {
            aprobados++;
        }
        else {
            reprobados++;
        }
    }
}

int main() {
    string nombres[TAM_MAX];
    float notas[TAM_MAX];
    int n;

    cout << "=== REGISTRO DE CALIFICACIONES ===" << endl;
    cout << "Cuantos estudiantes desea registrar? ";
    cin >> n;

    // Validacion simple del tamano ingresado
    while (n <= 0 || n > TAM_MAX) {
        cout << "Ingrese un numero valido (1-" << TAM_MAX << "): ";
        cin >> n;
    }

    llenarDatos(nombres, notas, n);
    mostrarDatos(nombres, notas, n);

    float promedio = calcularPromedio(notas, n);
    int indiceMax = buscarMaximo(notas, n);
    int indiceMin = buscarMinimo(notas, n);

    int aprobados, reprobados;
    contarAprobadosReprobados(notas, n, aprobados, reprobados);

    cout << "\n===================================" << endl;
    cout << "           ESTADISTICAS" << endl;
    cout << "===================================" << endl;
    cout << fixed << setprecision(2);
    cout << "Promedio general: " << promedio << endl;
    cout << "Nota mas alta: " << nombres[indiceMax] << " con " << notas[indiceMax] << endl;
    cout << "Nota mas baja: " << nombres[indiceMin] << " con " << notas[indiceMin] << endl;
    cout << "Estudiantes aprobados: " << aprobados << endl;
    cout << "Estudiantes reprobados: " << reprobados << endl;

    cin.ignore();
    cin.get(); // evita que la consola se cierre en Visual Studio
    return 0;
}
